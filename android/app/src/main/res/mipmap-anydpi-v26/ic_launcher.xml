<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/ic_launcher_background"/>
  <foreground>
      <inset
          android:drawable="@drawable/ic_launcher_foreground"
          android:inset="16%" />
  </foreground>
  <!-- Themed icons (Android 13+): without this, launchers in themed mode
       improvise by shrinking the foreground into a tiny disc. The tint uses
       the drawable's alpha, so the colored network reads as a silhouette. -->
  <monochrome>
      <inset
          android:drawable="@drawable/ic_launcher_foreground"
          android:inset="16%" />
  </monochrome>
</adaptive-icon>
