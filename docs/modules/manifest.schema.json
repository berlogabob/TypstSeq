{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typseq.local/manifest.schema.json",
  "title": "TyLog Module Pack manifest",
  "description": "Schema for manifest.json inside a .tylogpack (TyLog Module Pack v1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "version", "files"],
  "properties": {
    "schema": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      },
      "minItems": 1
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(notes|assets)/.+"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
