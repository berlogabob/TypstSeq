<?xml version="1.0" encoding="UTF-8"?>
<!-- Optional, only for headless/server vaults; the app clusters by itself. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>org.tylog.cluster</string>
  <key>ProgramArguments</key>
  <array>
    <string>@HOME@/.local/bin/tylog</string>
    <string>cluster</string>
    <string>@HOME@/Nextcloud/TyLogVault</string>
  </array>
  <key>WorkingDirectory</key><string>@HOME@/Nextcloud/TyLogVault</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>TYLOG_REPOSITORY_ROOT</key><string>@HOME@/.local/share/tylog</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>15</integer></dict>
  <key>StartInterval</key><integer>600</integer>
  <key>ThrottleInterval</key><integer>120</integer>
  <key>StandardOutPath</key><string>@HOME@/Library/Logs/tylog-cluster.log</string>
  <key>StandardErrorPath</key><string>@HOME@/Library/Logs/tylog-cluster.log</string>
</dict>
</plist>
